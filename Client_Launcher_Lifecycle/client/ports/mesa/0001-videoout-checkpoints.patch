+/* Consumer diagnostic adapter;all Vulkan/OS results remain unchanged. */
+#include <stdarg.h>
+extern void client_gpu_stage(const char *,int);
+static unsigned videoout_probe_events;
+static void videoout_probe(const char *format,...)
+{
+   if (__atomic_fetch_add(&videoout_probe_events,1,__ATOMIC_RELAXED)>=64)return;
+   char line[384];va_list args;va_start(args,format);
+   vsnprintf(line,sizeof(line),format,args);va_end(args);
+   client_gpu_stage(line,INT32_MIN);
+}
+static VkResult videoout_probe_result(const char *where,VkResult result)
+{
+   if(result!=VK_SUCCESS)videoout_probe("WSI failure %s result%d",where,result);
+   return result;
+}
