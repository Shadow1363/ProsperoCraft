+/* Startup uses the real WSI owner before Main's allocations. No buffer,
+ * swapchain, second handle or external ownership transfer is introduced. */
+PUBLIC int client_wsi_videoout_prepare(void);
+PUBLIC int
+client_wsi_videoout_prepare(void)
+{
+   call_once(&videoout_once, videoout_output_init_once);
+   mtx_lock(&videoout_output.lock);
+   const bool opened = videoout_open_locked();
+   const int result = opened ? 0 : videoout_output.handle;
+   videoout_probe("WSI prepare owned output result0x%08x handle0x%08x", (unsigned)result,
+                  (unsigned)videoout_output.handle);
+   mtx_unlock(&videoout_output.lock);
+   return result;
+}
