diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7f4bef4..9167c56 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1326,6 +1326,31 @@ if(SDL_HAPTIC)
 endif()
 
 
+# The PlayStation 5 (the payload SDK's toolchain sets PS5): a FreeBSD-like
+# system for threads, time and files, with the console's own video, audio and
+# pad drivers, kept outside this tree in SDL_PS5_PORT_DIR.
+if(PS5)
+  if(NOT SDL_PS5_PORT_DIR OR NOT SDL_PS5_PLATFORM_DIR)
+    message(FATAL_ERROR "PS5: set SDL_PS5_PORT_DIR (the drivers) and SDL_PS5_PLATFORM_DIR (platform.h)")
+  endif()
+  sdl_include_directories(PRIVATE "${SDL_PS5_PLATFORM_DIR}")
+  if(SDL_AUDIO)
+    set(SDL_AUDIO_DRIVER_PS5 1)
+    sdl_sources("${SDL_PS5_PORT_DIR}/SDL_ps5audio.c")
+    set(HAVE_SDL_AUDIO TRUE)
+  endif()
+  if(SDL_JOYSTICK)
+    set(SDL_JOYSTICK_PS5 1)
+    sdl_sources("${SDL_PS5_PORT_DIR}/SDL_ps5joystick.c")
+    set(HAVE_SDL_JOYSTICK TRUE)
+  endif()
+  if(SDL_VIDEO)
+    set(SDL_VIDEO_DRIVER_PS5 1)
+    sdl_sources("${SDL_PS5_PORT_DIR}/SDL_ps5video.c")
+    set(HAVE_SDL_VIDEO TRUE)
+  endif()
+endif()
+
 # General SDL subsystem options, valid for all platforms
 if(SDL_AUDIO)
   # CheckDummyAudio/CheckDiskAudio - valid for all platforms
@@ -2060,7 +2085,9 @@ elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
 
   if(SDL_JOYSTICK)
     if(FREEBSD OR NETBSD OR OPENBSD OR BSDI)
-      CheckUSBHID()
+      if(NOT PS5)
+        CheckUSBHID()
+      endif()
     endif()
     if((LINUX OR FREEBSD) AND HAVE_LINUX_INPUT_H AND NOT ANDROID)
       set(SDL_JOYSTICK_LINUX 1)
@@ -3446,7 +3473,7 @@ if(WINDOWS)
   )
   set(SDL_PROCESS_WINDOWS 1)
   set(HAVE_SDL_PROCESS TRUE)
-elseif(NOT ANDROID)
+elseif(NOT ANDROID AND NOT PS5)
   check_c_source_compiles("
 #include <spawn.h>
 #include <unistd.h>
@@ -3664,6 +3691,13 @@ endif()
 
 # config variables may contain generator expression, so we need to generate SDL_build_config.h in 2 steps:
 # 1. replace all `#cmakedefine`'s and `@abc@`
+if(PS5)
+  # SDK declarations do not establish target exports; use SDL implementations.
+  set(HAVE_WCSNLEN 0)
+  set(HAVE_WCSLCPY 0)
+  set(HAVE_WCSLCAT 0)
+  set(HAVE_NL_LANGINFO 0)
+endif()
 configure_file("${SDL3_SOURCE_DIR}/include/build_config/SDL_build_config.h.cmake"
   "${SDL3_BINARY_DIR}/CMakeFiles/SDL_build_config.h.intermediate")
 # 2. generate SDL_build_config.h in an build_type-dependent folder (which should be first in the include search path)
